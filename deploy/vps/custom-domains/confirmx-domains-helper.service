# /etc/systemd/system/confirmx-domains-helper.service
# ConfirmX custom domains: certificates (HTTP-01 webroot) + Nginx routing.
# One-shot, started by confirmx-domains-helper.timer.
#
# Runs as root only because certbot (writes /etc/letsencrypt) and
# `systemctl reload nginx` require it. It executes the ROOT-OWNED copy in
# /usr/local/lib/confirmx/domains-helper/ — never the app release tree
# (/opt/confirmx/...), which the unprivileged `confirmx` user owns. The helper
# also verifies this itself at start and exits if its files or any parent
# directory are not root-owned or are group/other-writable.
# Every directive below is explained in README.md ("systemd sandbox").
[Unit]
Description=ConfirmX custom-domain helper (certificates + nginx routing)
After=network-online.target nginx.service confirmx-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/confirmx/domains-helper.env
# Nothing from the environment may change how node loads code.
UnsetEnvironment=NODE_OPTIONS NODE_PATH
ExecStart=/usr/bin/node /usr/local/lib/confirmx/domains-helper/confirmx-domains-helper.mjs
TimeoutStartSec=15min
UMask=0022

# --- Filesystem: read-only everywhere except what certbot / nginx -t write ---
ProtectSystem=strict
ReadWritePaths=/etc/nginx/confirmx-custom-domains /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/www/certbot /var/log/nginx -/var/lib/nginx
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# --- Privileges ---
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
RestrictSUIDSGID=true

# --- Kernel / system surfaces it never needs ---
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# --- Network: loopback API, Let's Encrypt (HTTPS), systemd over a unix socket ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
