# /etc/systemd/system/confirmx-web.service
[Unit]
Description=ConfirmX dashboard (Next.js)
After=network-online.target confirmx-api.service
Wants=network-online.target

[Service]
Type=simple
User=confirmx
Group=confirmx
WorkingDirectory=/opt/confirmx/app/apps/web
EnvironmentFile=/etc/confirmx/web.env
# Next.js normalises 127.0.0.1 to "localhost" inside middleware; the server must use the
# same name, or every middleware rewrite/redirect becomes an external proxy to itself
# (Sites: self-proxy loop until OOM; Web: redirects to https://localhost:3001).
# ipv4first makes "localhost" bind 127.0.0.1 on hosts that list ::1 first.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
# PORT comes from web.env (3001); "localhost" keeps it off public interfaces.
Environment=HOSTNAME=localhost
ExecStart=/opt/confirmx/app/node_modules/.bin/next start --hostname localhost
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

Nice=5
CPUWeight=50
MemoryHigh=700M
MemoryMax=900M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
