# /etc/systemd/system/confirmx-sites.service
# Landing-page renderer (merchant landing pages on *.<landing domain> + the editor preview host).
[Unit]
Description=ConfirmX landing pages (Next.js renderer)
After=network-online.target confirmx-api.service
Wants=network-online.target

[Service]
Type=simple
User=confirmx
Group=confirmx
WorkingDirectory=/opt/confirmx/app/apps/sites
EnvironmentFile=/etc/confirmx/sites.env
# Next.js normalises 127.0.0.1 to "localhost" inside middleware; the server must use the
# same name, or every middleware rewrite/redirect becomes an external proxy to itself
# (Sites: self-proxy loop until OOM; Web: redirects to https://localhost:3001).
# ipv4first makes "localhost" bind 127.0.0.1 on hosts that list ::1 first.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/opt/confirmx/app/node_modules/.bin/next start --hostname localhost -p 3002
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

Nice=5
CPUWeight=50
MemoryHigh=500M
MemoryMax=700M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
