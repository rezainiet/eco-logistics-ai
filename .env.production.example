# ConfirmX — PRODUCTION environment template (VPS). NO REAL VALUES IN GIT.
#
# On the VPS each service reads its own file (root-owned, mode 0640, group confirmx):
#   /etc/confirmx/api.env     /etc/confirmx/web.env     /etc/confirmx/sites.env
# Real values live only there and in the offline secrets backup
# (E:\confirm-x\backups\confirmx\secrets\ — encrypted, never committed).
# Full inventory with purpose / where used: docs/infra/ENVIRONMENT.md
#
# R = required in production   O = optional   B = read at BUILD time (rebuild after changing)

# ─────────────────────────────── api.env ───────────────────────────────
NODE_ENV=production                         # R
API_PORT=4000                               # R  internal only; Nginx proxies api.<domain> → 127.0.0.1:4000
MONGODB_URI=                                # R  mongodb+srv://… (Atlas) or mongodb://127.0.0.1:27017/confirmx
REDIS_URL=                                  # R  redis://127.0.0.1:6379 (BullMQ queues + cache; required in prod)
JWT_SECRET=                                 # R  ≥16 chars; rotating it signs everyone out
ADMIN_SECRET=                               # R  ≥24 chars; guards /admin endpoints
COURIER_ENC_KEY=                            # R  base64 32 bytes; MUST be the same key as today or stored courier creds become unreadable
CORS_ORIGIN=https://app.confirmx.ai         # R  dashboard origin, no trailing slash
PUBLIC_API_URL=https://api.confirmx.ai      # R  webhook callback base, asset URLs
PUBLIC_WEB_URL=https://app.confirmx.ai      # R  links in emails
TRUSTED_PROXIES=loopback                    # R  on the VPS: only Nginx on 127.0.0.1 is trusted
SMS_WEBHOOK_SHARED_SECRET=                  # R* warned at boot if unset
RESEND_API_KEY=                             # O  transactional email
RESEND_WEBHOOK_SECRET=                      # O
EMAIL_FROM=                                 # O
STRIPE_SECRET_KEY=                          # O  billing
STRIPE_WEBHOOK_SECRET=                      # O
STRIPE_USE_USD=                             # O
STRIPE_PERIOD_DAYS=                         # O  default 30
STRIPE_GRACE_DAYS=                          # O  default 7
STRIPE_PRICE_STARTER=                       # O
STRIPE_PRICE_GROWTH=                        # O
STRIPE_PRICE_SCALE=                         # O
STRIPE_PRICE_ENTERPRISE=                    # O
SSL_WIRELESS_API_KEY=                       # O  SMS (Bangladesh)
SSL_WIRELESS_USER=                          # O
SSL_WIRELESS_SID=                           # O
SSL_WIRELESS_DEFAULT_SENDER=                # O
SSL_WIRELESS_BASE_URL=                      # O  default https://smsplus.sslwireless.com
TWILIO_ACCOUNT_SID=                         # O
TWILIO_AUTH_TOKEN=                          # O
TWILIO_PHONE_NUMBER=                        # O
TWILIO_WEBHOOK_BASE_URL=                    # O
SHOPIFY_APP_API_KEY=                        # O  Shopify public app
SHOPIFY_APP_API_SECRET=                     # O
PAY_BKASH_NUMBER=                           # O  manual subscription payments (display)
PAY_NAGAD_NUMBER=                           # O
PAY_BANK_INFO=                              # O
PAY_BKASH_TYPE=                             # O
PAY_NAGAD_TYPE=                             # O
PAY_MANUAL_DAILY_CAP=                       # O  default 3
SENTRY_DSN=                                 # O
SENTRY_RELEASE=                             # O
LANDING_ROOT_DOMAIN=                        # O  set in the DOMAIN phase; unset = every landing host 404s
LANDING_PUBLIC_URL_PATTERN=                 # O  e.g. https://{slug}.<landing domain>
LANDING_SLUG_HOLD_DAYS=                     # O  default 90
LANDING_MAX_PAGES_PER_MERCHANT=             # O  default 50
TRIAL_DAYS=                                 # O  default 14
TRIAL_WARNING_DAYS=                         # O  default 3
TRACKING_SYNC_INTERVAL_MIN=                 # O  default 60
TRACKING_SYNC_BATCH=                        # O  default 100
CUSTOMER_DATA_RETENTION_DAYS=               # O  default 365
CUSTOMER_DATA_RETENTION_INTERVAL_MIN=       # O
COURIER_MOCK=                               # O  never "1" in production
PATHAO_BASE_URL=                            # O  defaults to the courier's production API
STEADFAST_BASE_URL=                         # O
REDX_BASE_URL=                              # O
BDCOURIER_ENABLED=                          # O  feature flags below default as in apps/api/src/env.ts
BDCOURIER_API_KEY=                          # O
BDCOURIER_TIMEOUT_MS=                       # O
BDCOURIER_BASE_URL=                         # O
FRAUD_NETWORK_ENABLED=                      # O
FRAUD_NETWORK_DECAY_DAYS=                   # O
FRAUD_NETWORK_WARMING_FLOOR=                # O
ADDRESS_QUALITY_ENABLED=                    # O
ADDRESS_CANONICALIZATION_ENABLED=           # O
INTENT_SCORING_ENABLED=                     # O
DELIVERY_RELIABILITY_WRITE_ENABLED=         # O
DELIVERY_RELIABILITY_OBSERVABILITY_ENABLED= # O
DELIVERY_RELIABILITY_READ_ENABLED=          # O
DELIVERY_RELIABILITY_ANALYTICS_ENABLED=     # O
DELIVERY_RELIABILITY_ROLLOUT_MERCHANTS=     # O
LANE_INTELLIGENCE_WRITE_ENABLED=            # O
LANE_INTELLIGENCE_READ_ENABLED=             # O
EXTERNAL_DELIVERY_ENABLED=                  # O
EXTERNAL_DELIVERY_TTL_HOURS=                # O
EXTERNAL_DELIVERY_PROVIDER_TIMEOUT_MS=      # O
EXTERNAL_DELIVERY_PATHAO_ENABLED=           # O
EXTERNAL_DELIVERY_STEADFAST_ENABLED=        # O
EXTERNAL_DELIVERY_REDX_ENABLED=             # O
NETWORK_EVIDENCE_SURFACE_ENABLED=           # O
SHOPIFY_FETCH_TIMEOUT_MS=                   # O  integration tuning (process.env, not in env.ts)
SHOPIFY_RETRY_MAX_ATTEMPTS=                 # O
WOO_FETCH_TIMEOUT_MS=                       # O
WOO_RETRY_MAX_ATTEMPTS=                     # O
BRANDING_OVERRIDES=                         # O

# ─────────────────────────────── web.env ───────────────────────────────
NODE_ENV=production                         # R
PORT=3001                                   # R  internal only; Nginx proxies app.<domain> → 127.0.0.1:3001
NEXTAUTH_URL=https://app.confirmx.ai        # R
NEXTAUTH_SECRET=                            # R  same value as today or every session is signed out
NEXT_PUBLIC_API_URL=https://api.confirmx.ai # R B
NEXT_PUBLIC_WEB_URL=https://app.confirmx.ai # R B
PUBLIC_API_URL=https://api.confirmx.ai      # O  server-side fallback
NEXT_PUBLIC_SUPPORT_WHATSAPP=               # O B
NEXT_PUBLIC_SUPPORT_URL=                    # O B
NEXT_PUBLIC_SENTRY_DSN=                     # O B
NEXT_PUBLIC_SENTRY_RELEASE=                 # O B
NEXT_PUBLIC_SHOPIFY_APP_API_KEY=            # O B
NEXT_PUBLIC_INCIDENT_BANNER_LEVEL=          # O B
NEXT_PUBLIC_INCIDENT_BANNER_TEXT=           # O B
NEXT_PUBLIC_EXTERNAL_DELIVERY_UI_ENABLED=   # O B
NEXT_PUBLIC_NETWORK_EVIDENCE_UI_ENABLED=    # O B
NEXT_PUBLIC_LANDING_PREVIEW_URL=            # O B  landing editor preview host (DOMAIN phase); also added to CSP frame-src
CSP_ENFORCED=                               # O B  "true" switches the dashboard CSP from report-only to enforced

# ─────────────────────────────── sites.env ─────────────────────────────
# Landing-page renderer. Not publicly routed until the DOMAIN + WILDCARD DNS phase.
NODE_ENV=production                         # R
PORT=3002                                   # R  internal only
LANDING_API_URL=http://127.0.0.1:4000       # R B  API over loopback (same VPS)
LANDING_ASSET_ORIGIN=https://api.confirmx.ai # R B  public origin serving /api/landing-assets (CSP img-src)
LANDING_ROOT_DOMAIN=                        # O B  DOMAIN phase
LANDING_PREVIEW_HOST=                       # O B  DOMAIN phase
LANDING_EDITOR_ORIGINS=https://app.confirmx.ai # O B
LANDING_ALLOW_INDEXING=                     # O    "true" lets search engines index landing pages
LANDING_ANALYTICS=                          # O B  "off" disables merchant Meta Pixels platform-wide
